# Copy this file to deploy/release.env and fill in your real values.
#   cp deploy/release.env.example deploy/release.env
#
# deploy/release.env is gitignored — it holds secrets and must never be committed.
# Write values WITHOUT angle brackets. Quote anything containing spaces or symbols.

# ── Required ────────────────────────────────────────────────────────────────
# Your VM's public IPv4 (Oracle console → Compute → Instances), or its hostname.
VM_HOST=129.213.0.0

# Path to the private key you downloaded when creating the VM.
SSH_KEY=~/Downloads/ssh-key-2026-01-01.key

# The editor password for /admin on the deployed site.
ADMIN_PASSWORD='choose-a-strong-password'

# ── Optional ────────────────────────────────────────────────────────────────
# Your DuckDNS (or other) domain. Leave empty for plain HTTP on the bare IP.
APP_DOMAIN=pressjournals.duckdns.org

# Login user on the VM (Oracle's Ubuntu images use "ubuntu").
VM_USER=ubuntu

# Email — leave blank until you have an SMTP provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
